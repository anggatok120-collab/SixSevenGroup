# ID grup kelas (dapatkan dengan mengetik /groupid di grup setelah bot jalan)
GROUP_JID=1203630xxxxxxxxx@g.us
# Nomor yang boleh menambah/menghapus data, format 628xxx, pisahkan koma
ADMIN_NUMBERS=628123456789
# Selisih jam dari UTC: 7 = WIB, 8 = WITA, 9 = WIT
TZ_OFFSET=7
# Jam ringkasan harian (HH:mm)
DAILY_SUMMARY_AT=06:00
# Menit sebelum kelas dimulai
CLASS_REMINDER_MIN=30
# Pengingat tugas, dalam menit sebelum deadline (default H-3, H-1, 3 jam)
TASK_REMINDERS_MIN=4320,1440,180
# Pengingat ujian, dalam menit sebelum mulai (default H-7, H-1)
EXAM_REMINDERS_MIN=10080,1440
# Jam pengingat pagi hari-H ujian
EXAM_MORNING_AT=06:00

# ---- Web UI ----
# Password untuk login ke web (wajib, kalau kosong web tidak jalan)
ADMIN_PASSWORD=ganti-dengan-password-kuat
# Port lokal, nanti di-proxy oleh nginx ke domainmu
WEB_PORT=3000
# true = teman sekelas bisa lihat jadwal tanpa login (edit tetap butuh login)
PUBLIC_VIEW=true
